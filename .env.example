# En local no hace falta este archivo: los datos se guardan en data/almacen.
# Cuando haya Supabase, copia este archivo a .env.local y rellena DATABASE_URL.

# Base de datos de Supabase (Postgres). Si está vacía, se usa la base local.
# Supabase > botón "Connect" (arriba) > "Transaction pooler" (puerto 6543).
# Cambia [YOUR-PASSWORD] por la contraseña de la base de datos del proyecto.
# DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Secreto para firmar las sesiones. OBLIGATORIO en producción: sin él cualquiera
# que conozca el código podría fabricar una sesión de administrador.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=

# Kárdex externo (dashboard Flask que imprime el QR de la paleta).
# La dirección es un túnel que cambia: no va en el código. Sin estas tres
# variables, Registrar entradas sigue usando la copia local.
# En Vercel: Project → Settings → Environment Variables (Production y Preview).
# KARDEX_EXTERNO_URL=https://tu-tunel.trycloudflare.com
# KARDEX_EXTERNO_USUARIO=
# KARDEX_EXTERNO_CLAVE=
